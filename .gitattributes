# MULTIPLY — enforce LF for all text files (CLAUDE.md rule #3).
# Auto-detect text vs binary; every text file is stored AND checked out as LF,
# regardless of platform or core.autocrlf. Splice anchors rely on pure-LF (#3).
* text=auto eol=lf

# Explicit text types in this repo (belt-and-suspenders over text=auto).
*.html  text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.css   text eol=lf
*.sql   text eol=lf

# Binary assets — never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
